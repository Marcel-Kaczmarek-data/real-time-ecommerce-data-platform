{
  "type": "record",
  "name": "ShipmentsEvent",
  "namespace": "com.ecommerce.events",
  "doc": "Standard event envelope carrying a shipments payload. Allowed event_type values: shipment_created, shipment_in_transit, shipment_delayed, shipment_delivered",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "Globally unique event id (UUID)"
    },
    {
      "name": "event_type",
      "type": "string",
      "doc": "Business event name"
    },
    {
      "name": "event_version",
      "type": "int",
      "doc": "Payload contract version"
    },
    {
      "name": "event_timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Business event time (UTC)"
    },
    {
      "name": "source_system",
      "type": "string",
      "doc": "Emitting system"
    },
    {
      "name": "correlation_id",
      "type": "string",
      "doc": "Journey / order correlation id"
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "ShipmentsPayload",
        "fields": [
          {
            "name": "shipment_id",
            "doc": "Business key",
            "type": "string"
          },
          {
            "name": "order_id",
            "doc": "FK orders",
            "type": "string"
          },
          {
            "name": "warehouse_id",
            "doc": "Shipping warehouse",
            "type": "string"
          },
          {
            "name": "carrier",
            "doc": "Carrier name",
            "type": "string"
          },
          {
            "name": "shipment_status",
            "doc": "created | in_transit | delayed | delivered",
            "type": "string"
          },
          {
            "name": "shipped_at",
            "doc": "Hand-over to carrier (UTC)",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null
          },
          {
            "name": "estimated_delivery",
            "doc": "Promised delivery (UTC)",
            "type": {
              "type": "long",
              "logicalType": "timestamp-millis"
            }
          },
          {
            "name": "actual_delivery",
            "doc": "Proof of delivery (UTC)",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null
          },
          {
            "name": "tracking_number",
            "doc": "Carrier tracking number",
            "type": "string"
          },
          {
            "name": "destination_country",
            "doc": "ISO 3166-1 alpha-2",
            "type": "string"
          }
        ]
      }
    }
  ]
}
