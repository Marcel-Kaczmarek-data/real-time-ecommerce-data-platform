{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ecommerce.example/shipments.schema.json",
  "title": "ShipmentsEvent",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "event_timestamp",
    "source_system",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "enum": [
        "shipment_created",
        "shipment_in_transit",
        "shipment_delayed",
        "shipment_delivered"
      ]
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "event_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source_system": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "required": [
        "shipment_id",
        "order_id",
        "warehouse_id",
        "carrier",
        "shipment_status",
        "estimated_delivery",
        "tracking_number",
        "destination_country"
      ],
      "properties": {
        "shipment_id": {
          "type": "string",
          "description": "Business key"
        },
        "order_id": {
          "type": "string",
          "description": "FK orders"
        },
        "warehouse_id": {
          "type": "string",
          "description": "Shipping warehouse"
        },
        "carrier": {
          "type": "string",
          "description": "Carrier name"
        },
        "shipment_status": {
          "type": "string",
          "description": "created | in_transit | delayed | delivered"
        },
        "shipped_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "description": "Hand-over to carrier (UTC)"
        },
        "estimated_delivery": {
          "type": "string",
          "format": "date-time",
          "description": "Promised delivery (UTC)"
        },
        "actual_delivery": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "description": "Proof of delivery (UTC)"
        },
        "tracking_number": {
          "type": "string",
          "description": "Carrier tracking number"
        },
        "destination_country": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
