[sqlfluff]
dialect = sparksql
templater = raw
max_line_length = 130
# Cosmetic rules disabled: the marts align columns / aliases for readability
# (LT01, LT02), mix lower-case aggregate helpers with upper-case keywords (CP03),
# alias tables implicitly (AL01) and order join conditions freely (ST09).
# Correctness-oriented rules (unused CTEs ST03, ambiguous references RF02/AM04,
# DISTINCT misuse AM01, keyword case CP01...) stay enabled.
exclude_rules = LT01, LT02, LT05, LT09, LT14, CP03, AL01, ST09, ST06, AM04, CV03, ST05, RF03, RF04

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:references.consistent]
single_table_references = unqualified
