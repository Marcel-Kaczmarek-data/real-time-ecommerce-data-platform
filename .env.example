# =============================================================================
# Real-Time E-Commerce Data Platform - environment configuration (TEMPLATE)
#
# Copy to `.env` (`make setup` does this) and adjust.
# The values below are LOCAL DEVELOPMENT DEFAULTS for throw-away Docker
# containers only. They are intentionally weak and MUST NOT be used in any
# shared or production environment. Production secrets come from AWS Secrets
# Manager / Databricks secret scopes (see docs/security.md).
# =============================================================================

# --- Runtime environment: local | cloud ---
PLATFORM_ENV=local
# lite = laptop-friendly volumes, full = 100k customers / 10k products reference scale
PLATFORM_SCALE=lite
LOG_LEVEL=INFO

# --- PostgreSQL (operational source database + Airflow metadata) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-local-only

# --- Kafka / Schema Registry ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# --- Object storage (S3-compatible SeaweedFS locally, AWS S3 in the cloud) ---
S3_ENDPOINT_URL=http://object-storage:9000
AWS_REGION=us-east-1
# Local S3 credentials (rendered into the object store's identity file; IAM roles in AWS)
AWS_ACCESS_KEY_ID=localdev
AWS_SECRET_ACCESS_KEY=change-me-local-only
LAKEHOUSE_BUCKET=lakehouse
LANDING_BUCKET=landing

# --- Spark ---
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-local-only
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=change-me-local-only

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# --- Monitoring ---
PUSHGATEWAY_URL=http://pushgateway:9091

# --- Masking salt used to pseudonymise customer PII in Silver (rotate per environment) ---
PII_HASH_SALT=change-me-local-only

# --- Event generator ---
GENERATOR_SEED=42
GENERATOR_EVENTS_PER_SECOND=200

# --- Host ports (change if they clash with other local services) ---
AIRFLOW_WEB_PORT=8088
POSTGRES_HOST_PORT=5433
GRAFANA_HOST_PORT=3001
REFERENCE_API_HOST_PORT=8090
