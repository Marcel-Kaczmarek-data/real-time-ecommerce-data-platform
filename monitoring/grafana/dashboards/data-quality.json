{
  "uid": "data-quality",
  "title": "Data quality",
  "description": "Rule-suite results, failed checks by severity, freshness.",
  "tags": [
    "ecommerce-platform"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
